# Private working material: notes, lab-meeting notes, drafts of correspondence. Never tracked.
notes/

# Local environments, caches, OS files
.venv*/
src/.venv*/
__pycache__/
*.pyc
.DS_Store

# Backups made before the folder had history
*.bak
*.bak_*

# Raw simulation arrays (about 1.5 GB). Per-run statistics (*.json) and logs are tracked.
results/runs/**/*.npz
# ...except the two small arrays the checks and the write-up read directly
!results/runs/validation/tvb_ref_dump.npz
!results/runs/validation/traces_wp.npz
# ...and the per-region numbers of every sweep run (5.8 MB), which the per-region analysis reads
!results/runs/sweep/node_stats_sweep.npz
!results/runs/validation/blowup_record_f32.npz
# the paper's text: third-party, kept locally only
external/fousek2024/
